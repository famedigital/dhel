<!-- NitroPack Cleanup: Hide branding + layout div -->
<style>
  /* Hide NitroPack branding via classes */
  .nitropack-branding,
  .nitropack-powered-by,
  .juNAND1gGUcjhjMZYMUzMQYD0Zh4jz4 juNAND1gGUcjhjMZYMUzMQYD0Zh4jz4theme--light {
    display: none !important;
  }

  /* Attempt early CSS-based hiding of layout-clearing divs */
  div[style*="display"][style*="clear"] {
    display: none !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const divs = document.querySelectorAll('div[style*="display"][style*="clear"]');
    divs.forEach(div => {
      if (div.innerHTML.trim() === "") {
        div.style.display = "none";
      }
    });
  });
</script>

	</body>
